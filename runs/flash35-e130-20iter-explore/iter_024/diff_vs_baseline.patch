+class BlurPool2d(nn.Module):
+    """
+    Anti-aliased downsampling (BlurPool) module using a 3x3 binomial filter
+    [1, 2, 1] x [1, 2, 1]^T / 16 (Zhang 2019).
+    """
+
+    def __init__(self, channels, stride=2):
+        super().__init__()
+        self.stride = stride
+        kernel = torch.tensor([
+            [1.0, 2.0, 1.0],
+            [2.0, 4.0, 2.0],
+            [1.0, 2.0, 1.0]
+        ])
+        kernel = kernel / kernel.sum()
+        self.register_buffer('kernel', kernel.view(1, 1, 3, 3).repeat(channels, 1, 1, 1))
+
+    def forward(self, x):
+        return F.conv2d(x, self.kernel, stride=self.stride, padding=1, groups=x.shape[1])
+
+
+class GeMPool2d(nn.Module):
+    """
+    Generalized Mean (GeM) Pooling with power p=3.0.
+    Bridges Average Pooling (p=1) and Max Pooling (p->infinity) to emphasize
+    salient feature regions smoothly.
+    """
+
+    def __init__(self, p=3.0, eps=1e-6):
+        super().__init__()
+        self.p = p
+        self.eps = eps
+
+    def forward(self, x):
+        return x.clamp(min=self.eps).pow(self.p).mean(dim=(-2, -1)).pow(1.0 / self.p)
+
+
+class AntiAliasedBasicBlock(nn.Module):
+    """ResNet BasicBlock with BlurPool anti-aliased downsampling."""
+    expansion = 1
+
+    def __init__(self, in_planes, planes, stride=1):
+        super().__init__()
+        if stride == 2:
+            self.conv1 = nn.Conv2d(in_planes, planes, kernel_size=3, stride=1, padding=1, bias=False)
+            self.blur1 = BlurPool2d(planes, stride=2)
+        else:
+            self.conv1 = nn.Conv2d(in_planes, planes, kernel_size=3, stride=1, padding=1, bias=False)
+            self.blur1 = nn.Identity()
+
+        self.bn1 = nn.BatchNorm2d(planes)
+        self.conv2 = nn.Conv2d(planes, planes, kernel_size=3, stride=1, padding=1, bias=False)
+        self.bn2 = nn.BatchNorm2d(planes)
+
+        self.shortcut = nn.Sequential()
+        if stride != 1 or in_planes != self.expansion * planes:
+            if stride == 2:
+                self.shortcut = nn.Sequential(
+                    nn.Conv2d(in_planes, self.expansion * planes, kernel_size=1, stride=1, bias=False),
+                    BlurPool2d(self.expansion * planes, stride=2),
+                    nn.BatchNorm2d(self.expansion * planes)
+                )
+            else:
+                self.shortcut = nn.Sequential(
+                    nn.Conv2d(in_planes, self.expansion * planes, kernel_size=1, stride=1, bias=False),
+                    nn.BatchNorm2d(self.expansion * planes)
+                )
+
+    def forward(self, x):
+        out = self.conv1(x)
+        out = self.blur1(out)
+        out = F.relu(self.bn1(out))
+        out = self.bn2(self.conv2(out))
+        out += self.shortcut(x)
+        out = F.relu(out)
+        return out
+
