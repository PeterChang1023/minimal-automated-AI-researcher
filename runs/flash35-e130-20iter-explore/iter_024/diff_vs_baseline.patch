+class TriplePooledMultiScaleCIFARResNet26(nn.Module):
+    """
+    CIFAR-adapted ResNet-26 ([3, 3, 3, 3] blocks) with 1.75x width multiplier
+    (channels [112, 224, 448, 896]) and Triple-Pooled Multi-Scale Feature Aggregation.
+
+    Concatenates Global Average Pooled, Generalized Mean Pooled (p=3.0), and Global Max Pooled
+    features from both Stage 3 (448-dim, 8x8) and Stage 4 (896-dim, 4x4) into a 4032-dim representation
+    standardized via BatchNorm1d.
+    """
+
+    def __init__(self, width_mult=1.75):
+        super().__init__()
+        base_channels = [int(c * width_mult) for c in [64, 128, 256, 512]]  # [112, 224, 448, 896]
+        self.in_planes = base_channels[0]
+
+        # CIFAR stem: 3x3 conv, stride 1, no maxpool
+        self.conv1 = nn.Conv2d(3, base_channels[0], kernel_size=3, stride=1, padding=1, bias=False)
+        self.bn1 = nn.BatchNorm2d(base_channels[0])
+
+        # Layer depths: [3, 3, 3, 3] = ResNet-26
+        self.layer1 = self._make_layer(AntiAliasedBasicBlock, base_channels[0], 3, stride=1)
+        self.layer2 = self._make_layer(AntiAliasedBasicBlock, base_channels[1], 3, stride=2)
+        self.layer3 = self._make_layer(AntiAliasedBasicBlock, base_channels[2], 3, stride=2)
+        self.layer4 = self._make_layer(AntiAliasedBasicBlock, base_channels[3], 3, stride=2)
+
+        self.avgpool = nn.AdaptiveAvgPool2d((1, 1))
+        self.gempool = GeMPool2d(p=3.0)
+        self.maxpool = nn.AdaptiveMaxPool2d((1, 1))
+
+        # Output feature dimension: 3 * 448 [stage 3] + 3 * 896 [stage 4] = 1344 + 2688 = 4032
+        out_dim = (base_channels[2] + base_channels[3]) * 3
+        self.bn_out = nn.BatchNorm1d(out_dim)
+
+    def _make_layer(self, block, planes, num_blocks, stride):
+        strides = [stride] + [1] * (num_blocks - 1)
+        layers = []
+        for s in strides:
+            layers.append(block(self.in_planes, planes, s))
+            self.in_planes = planes * block.expansion
+        return nn.Sequential(*layers)
+
+    def forward(self, x):
+        out = F.relu(self.bn1(self.conv1(x)))
+        out = self.layer1(out)
+        out = self.layer2(out)
+        stage3_out = self.layer3(out)
+        stage4_out = self.layer4(stage3_out)
+
+        f3_avg = torch.flatten(self.avgpool(stage3_out), 1)
+        f3_gem = self.gempool(stage3_out)
+        f3_max = torch.flatten(self.maxpool(stage3_out), 1)
+
+        f4_avg = torch.flatten(self.avgpool(stage4_out), 1)
+        f4_gem = self.gempool(stage4_out)
+        f4_max = torch.flatten(self.maxpool(stage4_out), 1)
+
+        f_multi = torch.cat([f3_avg, f3_gem, f3_max, f4_avg, f4_gem, f4_max], dim=1)
+        return self.bn_out(f_multi)
 
 
